    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Renly\0"
            VALUE "FileDescription",  "RifeOS 桌面工作空间专业版\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "RIFEOS\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Renly. All rights reserved.\0"
            VALUE "OriginalFilename", "RIFEOS.exe\0"
            VALUE "ProductName",      "RifeOS\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Renly\0"
            VALUE "FileDescription",  "RifeOS Desktop Workspace Edition\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "RIFEOS\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Renly. All rights reserved.\0"
            VALUE "OriginalFilename", "RIFEOS.exe\0"
            VALUE "ProductName",      "RifeOS\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200, 0x0409, 1200
    END
END
